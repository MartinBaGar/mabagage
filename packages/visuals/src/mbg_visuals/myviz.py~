@cmd.extend
def pic_pretty():
    """Quick matte render for presentations."""
    cmd.bg_color("white")
    cmd.set("ray_opaque_background", "off")
    cmd.set("antialias", 1)

    # Matte settings
    cmd.set("ambient", 0.4)
    cmd.set("direct", 0.2)
    cmd.set("specular", 0)
    cmd.set("ray_shadow", 0)
    cmd.set("ray_trace_mode", 0)
    cmd.ray()


@cmd.extend
def pic_med():
    """Matte finish with depth/shadows, no outlines."""
    cmd.bg_color("white")
    cmd.set("ray_opaque_background", "off")
    cmd.color("red")
    cmd.set("antialias", 2)

    # Matte settings
    cmd.set("ambient", 0.5)
    cmd.set("direct", 0.5)
    cmd.set("specular", 0.1)
    cmd.set("spec_reflect", 0)
    cmd.set("shininess", 0)

    cmd.set("ray_shadow", 1)
    cmd.set("ray_trace_mode", 0)


@cmd.extend
def pic_pub():
    """Professional Matte: High-quality geometry with thin outlines."""
    cmd.bg_color("white")
    cmd.set("ray_opaque_background", "off")
    cmd.set("antialias", 2)

    # Ultra-Matte Surface Math
    cmd.set("ambient", 0.5)
    cmd.set("direct", 0.45)
    cmd.set("specular", 0.05)
    cmd.set("spec_reflect", 0)
    cmd.set("shininess", 0)

    # High-End Geometry
    cmd.set("cartoon_sampling", 14)
    cmd.set("ribbon_sampling", 14)

    # Outlines that won't drown out small details
    cmd.set("ray_trace_mode", 1)
    cmd.set("ray_trace_gain", 0.2)
    cmd.set("ray_trace_depth_factor", 0.1)
    cmd.set("ray_shadow", 1)

    cmd.ray(2400, 2400)


